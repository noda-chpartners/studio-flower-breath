---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title={`ページが見つかりません｜${site.name}`} description="お探しのページは見つかりませんでした。" noindex>
  <main id="main" class="missing">
    <p class="eyebrow">404</p>
    <h1>ページが見つかりません</h1>
    <p>アドレスをご確認いただくか、トップページからお探しください。</p>
    <a class="btn" href="/">トップへ戻る</a>
  </main>
</Layout>
