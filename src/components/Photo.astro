---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths: number[];
  class?: string;
  priority?: boolean;
}

const { src, alt, sizes, widths, class: className, priority = false } = Astro.props;
---

<div class:list={["frame", className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={priority ? 82 : 75}
    layout="full-width"
    priority={priority}
  />
</div>
